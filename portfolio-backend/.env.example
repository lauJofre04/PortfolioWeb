# Copiá este archivo a .env y completá los valores. NO subas .env al repositorio.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Mínimo 32 caracteres aleatorios. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:4200,https://portfolio-web-jofre-lautaro.vercel.app

PORT=3000
